{
  "name": "a2ui-showcase-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-driven UI showcase: an LLM composes A2UI v1.0 messages from a component catalog and the official SDK renders them in React.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "catalog:sync": "tsx scripts/sync-basic-catalog.ts"
  },
  "dependencies": {
    "@a2ui/agent": "0.1.0",
    "@a2ui/markdown-it": "0.2.2",
    "@a2ui/react": "0.15.0",
    "@a2ui/web_core": "0.15.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/material-symbols-outlined": "5.3.9",
    "@google/genai": "3.2.0",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "happy-dom": "21.0.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "@a2ui/markdown-it": {
      "@a2ui/web_core": "$@a2ui/web_core"
    }
  }
}
