# Copy to .env (never commit .env). Every value is read by the server only;
# nothing here is exposed to the browser.

# --- Server ---------------------------------------------------------------
PORT=8787
# HOST=127.0.0.1

# --- Gemini (Google Gen AI SDK) -------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
# How the model writes A2UI: json (the wire format) or express (the SDK's
# compact shorthand, compiled by the SDK to the same messages).
GEMINI_FORMAT=json
# json format only. true = ask Gemini for raw JSON (responseMimeType
# application/json); false = tagged JSON, which also allows a short text reply.
GEMINI_JSON_MODE=false

# --- Local model (any OpenAI-compatible server) ---------------------------
# LM Studio: http://localhost:1234/v1    Ollama: http://localhost:11434/v1
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
# express keeps the prompt near 6K tokens; json needs about 11K, more than many
# local servers load by default.
LOCAL_LLM_FORMAT=express
# Most local servers ignore this; set it if yours requires one.
LOCAL_LLM_API_KEY=
# The endpoint must be on this machine unless this is true.
LOCAL_LLM_ALLOW_REMOTE=false
# Local models are slow on the full catalog prompt; raise if requests time out.
LOCAL_LLM_TIMEOUT_MS=180000

# --- Generation -----------------------------------------------------------
# Provider selected when the app loads: gemini | local | sample
DEFAULT_PROVIDER=sample
# How many times a live model may be asked again after invalid A2UI output.
MAX_ATTEMPTS=2
